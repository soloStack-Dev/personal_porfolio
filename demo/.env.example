# Copy to `.env` and fill in only if you want the contact form to actually send mail.
# `docker compose` reads `.env` automatically. With SPRING_MAIL_HOST left empty the form
# logs submissions to `docker compose logs portfolio` and the page tells visitors it is not
# sending mail yet — which is honest, and the current behaviour.

# Host port to publish the site on (the container always listens on 8080).
PORT=8080

# --- SMTP relay (optional) ---
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS=true

# --- Where contact-form submissions go ---
APP_CONTACT_TO=faleelmr4@gmail.com
APP_CONTACT_FROM=portfolio@localhost
