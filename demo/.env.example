# Copy to `.env` and fill in to let the contact form actually send mail.
#
# `docker compose` loads this file automatically (env_file, required: false).
# The file is gitignored. Absent is the only truly-unset value: do NOT write
# `SPRING_MAIL_HOST=` empty, because Spring Boot treats an empty string as a
# present host and will try to build a mail sender against nothing. Comment the
# line out instead, which keeps the no-config fallback working.

# Host port to publish the site on (the container always listens on 8080).
PORT=8080

# --- SMTP relay ------------------------------------------------------------
# Only the flat properties are valid here. spring.mail has no `starttls` and no
# `smtp.auth` property, and STARTTLS/auth already come from application.properties,
# so setting them here would do nothing at all. There is no error and no warning
# for an unknown spring.mail.* key — it is silently ignored.
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=you@example.com
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROTOCOL=smtp
SPRING_MAIL_DEFAULT_ENCODING=UTF-8

# Implicit SSL (port 465). Set true for e.g. smtp.gmail.com:465, false for STARTTLS.
SPRING_MAIL_SSL_ENABLED=false

# Verify the relay at startup and refuse to boot if it is unreachable.
SPRING_MAIL_TEST_CONNECTION=false

# --- Where contact-form submissions go -------------------------------------
APP_CONTACT_TO=faleelmr4@gmail.com
# The From address must be one the relay is allowed to send as. It defaults to
# portfolio@localhost, which no real relay will accept.
APP_CONTACT_FROM=you@example.com
