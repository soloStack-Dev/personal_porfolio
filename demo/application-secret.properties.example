# Mail credentials. Copy to application-secret.properties and fill in - never commit the copy.
#
# This is a plain properties file loaded by application.properties via
#   spring.config.import=optional:file:application-secret.properties[.properties]
# It exists instead of putting these keys in src/main/resources/application.properties because
# that file is tracked by git AND packaged into the jar, and the GitHub repo is public.
#
# Password note: leave the value unquoted. '#' only starts a comment at the beginning of a
# line, so it is safe here mid-value. Quoting would be actively wrong - Spring keeps the quote
# characters as part of the password and authentication fails.

# Gmail: no client ID or secret is needed. Those are OAuth2 credentials; sending as yourself
# over SMTP uses username plus an App Password. Google removed "less secure app" access in
# 2022, so a normal account password is refused with "534-5.7.9 Application-specific password
# required". Create one: Google Account -> Security -> 2-Step Verification -> App passwords ->
# Mail -> Generate. 16 lowercase letters, shown in four groups.
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=
spring.mail.password=
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.ssl.enabled=false

# true makes the app refuse to start when the relay is unreachable or auth fails, which is
# worth enabling in production. It failed with 534-5.7.9 while an account password was still
# in place, so it is a genuinely useful startup check rather than a formality.
spring.mail.test-connection=false

app.contact.to=
# Must equal spring.mail.username or be an alias on it, or Gmail rejects the send with
# "550 The specified from address does not match a permitted sender".
app.contact.from=
